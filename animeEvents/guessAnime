const characters = require("../characters.json")
const { giveAnimeReward } = require("./AnimeRewards")

const states = new Map()

function randomCharacter() {

    const list = characters.filter(c =>
        c.anime &&
        c.anime.trim() &&
        c.name &&
        c.name.trim()
    )

    return list[
        Math.floor(
            Math.random() * list.length
        )
    ]

}

async function start(sock, jid) {

    const state = {

        currentQuestion: randomCharacter(),

        answered: false,

        timeout: null

    }

    states.set(jid, state)

    await sock.sendMessage(jid, {

        text:
`🎌 ═════〔 من أي أنمي؟ 〕═════

👤 الشخصية:

${state.currentQuestion.name}

━━━━━━━━━━━━━━

✍️ للإجابة:

.جواب اسم_الأنمي

⏳ الوقت:
5 دقائق`

    })

    state.timeout = setTimeout(async () => {

        if (state.answered)
            return

        await sock.sendMessage(jid, {

            text:
`⌛ انتهى الوقت

✅ الإجابة الصحيحة:

${state.currentQuestion.anime}`

        })

        states.delete(jid)

    }, 5 * 60 * 1000)

}

async function answer(sock, msg, player, text) {

    const jid = msg.key.remoteJid

    const state = states.get(jid)

    if (!state)
        return { handled: false }

    if (state.answered)
        return { handled: true }

    if (!text.startsWith(".جواب "))
        return { handled: false }

    const normalize = str =>

        str
            .toLowerCase()
            .replace(/\(.*?\)/g, "")
            .replace(/[^a-z0-9\u0600-\u06FF ]/g, " ")
            .replace(/\s+/g, " ")
            .trim()

    const userAnswer =
        normalize(
            text.slice(6)
        )

    const correctAnswer =
        normalize(
            state.currentQuestion.anime
        )

    if (
        userAnswer !== correctAnswer &&
        !correctAnswer.includes(userAnswer) &&
        !userAnswer.includes(correctAnswer)
    ) {

        return { handled: true }

    }

    state.answered = true

    clearTimeout(state.timeout)

    const reward =
        await giveAnimeReward(player)

    const animeName =
        state.currentQuestion.anime

    const characterName =
        state.currentQuestion.name

    states.delete(jid)

    return {

        handled: true,

        winner: player.userId,

        reward,

        extraText:
`👤 ${characterName}

🎌 ${animeName}`

    }

}

module.exports = {

    name: "guessAnime",

    start,

    answer

}
